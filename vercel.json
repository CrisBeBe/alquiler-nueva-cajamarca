{
  "version": 2,
  "name": "alquiler-nueva-cajamarca",
  "builds": [
    {
      "src": "backend/src/app.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "backend/src/app.js"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1",
      "continue": true
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/index.html"
    }
  ]
}
